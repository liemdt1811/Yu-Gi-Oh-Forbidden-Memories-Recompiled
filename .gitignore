# User-supplied copyrighted game files
/game/
*.[bB][iI][nN]
*.[cC][uU][eE]
*.[iI][sS][oO]
*.[cC][hH][dD]
*.[eE][cC][mM]
*.[pP][bB][pP]
**/[sS][lL][uU][sS]_[0-9][0-9][0-9].[0-9][0-9]

# Memory card images written by the native port
/saves/

# Generated and temporary project state
/tmp/
/dist/

# Locally installed or downloaded tool dependencies
/tools/downloads/
/tools/environments/
/tools/toolchains/
/tools/vendor/

# Tool-generated language caches
**/__pycache__/
*.py[cod]

# Konami card art fetched by tools/pc/real_cards/build_real_cards.py art
/mods/z/images/
/mods/z/portraits/
/mods/z-effects/*.o
/tools/pc/real_cards/backup/themed-packs/images/
/mods/z/art/
/tools/pc/real_cards/banner/art/
/tools/pc/real_cards/banner/*.png
